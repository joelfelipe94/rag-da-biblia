data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/*.db
!data/.gitkeep

# Variáveis de ambiente
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea/
*.swp
