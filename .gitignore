# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# TypeScript artifacts gerados ao compilar jest.config.ts na raiz
/jest.config.js
/jest.config.d.ts
/jest.config.d.ts.map

# Cobertura de testes
coverage/

# Bancos SQLite: as traduções e os bancos indexados não são versionados
